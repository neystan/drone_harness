#!/usr/bin/env python3

from __future__ import annotations

import os
import threading
import time
from pathlib import Path

import cv2
import rclpy
from cv_bridge import CvBridge
from drone_agent.vision import mouse_selection
from drone_agent.vision.overlay import (
    clear_detection_overlay,
    read_overlay_state,
)
from drone_agent.vision.tracking import (
    DisplayFrameRateMeter,
    FrameSequenceBuffer,
    RealtimeSamTracker,
    read_display_mode,
    select_display_frame,
)
from rclpy.node import Node
from sensor_msgs.msg import Image


CAMERA_NAME = "CameraDepth1"
CAMERA_SCENE_TOPIC = f"/airsim_node/PX4/{CAMERA_NAME}/Scene"
WINDOW_NAME = "Camera View Sim"


class CameraViewSim(Node):
    def __init__(self, name: str) -> None:
        super().__init__(name)
        self.sub = self.create_subscription(Image, CAMERA_SCENE_TOPIC, self.image_callback, 10)
        self.cv_bridge = CvBridge()
        self.should_exit = False
        self.last_time = time.time()
        self.fps = 0.0
        self.frame_count = 0
        self.latest_frame = None
        self.latest_frame_seq = 0
        self.displayed_frame = None
        self.displayed_frame_seq = 0
        self.frame_lock = threading.Lock()
        self.frame_ready = threading.Event()
        self.display_mode = read_display_mode(os.getenv("SAM2_DISPLAY_MODE"))
        self.visible_fps = 0.0
        self.visible_fps_meter = DisplayFrameRateMeter()
        self.tracking_display_active = False
        self.frame_buffer = FrameSequenceBuffer(capacity=40)
        self.realtime_tracker = RealtimeSamTracker()
        self.tracking_thread = threading.Thread(
            target=self.realtime_tracking_loop,
            daemon=True,
        )
        self.tracking_thread.start()
        cv2.namedWindow(WINDOW_NAME, cv2.WINDOW_AUTOSIZE)
        cv2.setMouseCallback(WINDOW_NAME, self.handle_mouse_event)
        self.get_logger().info(f"Camera topic subscribed: {CAMERA_SCENE_TOPIC}")

    def image_callback(self, msg: Image) -> None:
        """Update the preview window and estimate the current FPS."""
        self.frame_count += 1
        if self.frame_count >= 10:
            current_time = time.time()
            self.fps = 10.0 / (current_time - self.last_time)
            self.last_time = current_time
            self.frame_count = 0

        try:
            cv_image = self.cv_bridge.imgmsg_to_cv2(msg, desired_encoding="bgr8")
        except Exception as exc:
            self.get_logger().error(f"Image conversion failed: {exc}")
            return

        with self.frame_lock:
            self.latest_frame = cv_image.copy()
            self.latest_frame_seq += 1
            current_frame_seq = self.latest_frame_seq
            self.frame_ready.set()

        self.frame_buffer.put(current_frame_seq, cv_image)
        state = read_overlay_state()
        tracking = state.get("tracking")
        tracking_active = isinstance(tracking, dict)
        if tracking_active != self.tracking_display_active:
            self.visible_fps_meter.reset()
            self.tracking_display_active = tracking_active
        display_frame, display_frame_seq, draw_tracking_mask = select_display_frame(
            cv_image,
            current_frame_seq,
            tracking_active=tracking_active,
            display_mode=self.display_mode,
            mask_frame_seq=self.realtime_tracker.displayed_mask_sequence(),
            frame_buffer=self.frame_buffer,
        )
        with self.frame_lock:
            self.displayed_frame = display_frame.copy()
            self.displayed_frame_seq = display_frame_seq
        self.visible_fps = self.visible_fps_meter.update(display_frame_seq)

        self.apply_vision_overlay(
            display_frame,
            state,
            display_frame_seq,
            draw_tracking_mask,
        )
        self.realtime_tracker.maybe_log_perf(
            self.get_logger(),
            self.fps,
            current_frame_seq,
            display_frame_seq,
            self.display_mode,
            self.visible_fps,
        )
        delay_frames = max(0, current_frame_seq - display_frame_seq)
        delay_ms = 1000.0 * delay_frames / self.fps if self.fps > 0 else 0.0
        metrics = (
            f"Camera: {self.fps:.1f} FPS",
            f"Visible: {self.visible_fps:.1f} FPS",
            f"Delay: {delay_frames} frames / {delay_ms:.0f} ms",
        )
        for line_number, text in enumerate(metrics, start=1):
            cv2.putText(
                display_frame,
                text,
                (10, 25 * line_number),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.65,
                (0, 255, 0),
                2,
            )

        cv2.imshow(WINDOW_NAME, display_frame)
        key = cv2.waitKey(1) & 0xFF
        if key in (27, ord("q")):
            self.should_exit = True

    def realtime_tracking_loop(self) -> None:
        """收到新相机帧后尽快调用 SAM2 status 更新追踪 mask。"""
        last_processed_seq = 0
        while not self.should_exit:
            self.frame_ready.wait(timeout=0.5)
            self.frame_ready.clear()
            if self.should_exit:
                break

            with self.frame_lock:
                frame_seq = self.latest_frame_seq
            if frame_seq == last_processed_seq:
                continue

            state = read_overlay_state()
            tracking = state.get("tracking")
            if not isinstance(tracking, dict):
                last_processed_seq = frame_seq
                continue

            if self.update_realtime_tracking(tracking, frame_seq):
                last_processed_seq = frame_seq

    def update_realtime_tracking(self, tracking: dict, frame_seq: int) -> bool:
        """把与 frame_seq 严格对应的相机帧交给实时追踪器。"""
        frame = self.frame_buffer.get(frame_seq)
        if frame is None:
            return False
        return self.realtime_tracker.update(tracking, frame, frame_seq, self.get_logger())

    def apply_vision_overlay(
        self,
        frame,
        state: dict,
        display_frame_seq: int,
        draw_tracking_mask: bool,
    ) -> None:
        """把检测框和追踪 mask 叠加到相机画面。"""
        drew_detection = self.draw_detection_overlay(frame, state.get("detection"))
        self.draw_tracking_overlay(
            frame,
            state.get("tracking"),
            display_frame_seq,
            draw_tracking_mask,
        )
        self.draw_mouse_selection_overlay(frame)
        if drew_detection:
            clear_detection_overlay()

    def handle_mouse_event(self, event: int, x: int, y: int, _flags: int, _param) -> None:
        """处理相机窗口中的目标选择和取消操作。"""
        if event not in {cv2.EVENT_LBUTTONDOWN, cv2.EVENT_RBUTTONDOWN}:
            return
        state = mouse_selection.read_mouse_selection()
        request_id = str(state.get("request_id", ""))
        if state.get("status") != "waiting" or not request_id:
            return
        if event == cv2.EVENT_RBUTTONDOWN:
            mouse_selection.cancel_mouse_selection(request_id, "cancelled_by_mouse")
            self.get_logger().info("Mouse target selection cancelled")
            return

        with self.frame_lock:
            frame = None if self.displayed_frame is None else self.displayed_frame.copy()
            frame_seq = self.displayed_frame_seq
        if frame is None or not (0 <= x < frame.shape[1] and 0 <= y < frame.shape[0]):
            mouse_selection.fail_mouse_selection(request_id, "clicked frame is unavailable")
            return

        image_path = Path(str(state.get("image_path", "")))
        try:
            image_path.parent.mkdir(parents=True, exist_ok=True)
            saved = bool(cv2.imwrite(str(image_path), frame))
        except OSError as exc:
            mouse_selection.fail_mouse_selection(request_id, str(exc))
            return
        if not saved:
            mouse_selection.fail_mouse_selection(request_id, "failed to save clicked frame")
            return

        if mouse_selection.complete_mouse_selection(request_id, [x, y], frame_seq):
            self.get_logger().info(
                f"Mouse target selected: point=({x}, {y}) frame_seq={frame_seq}"
            )

    def draw_mouse_selection_overlay(self, frame) -> None:
        """绘制鼠标选点提示和短暂的点击标记。"""
        state = mouse_selection.read_mouse_selection()
        status = state.get("status")
        if status == "waiting":
            cv2.putText(
                frame,
                "Click target | Right-click cancel",
                (10, max(30, frame.shape[0] - 20)),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.65,
                (0, 255, 255),
                2,
                cv2.LINE_AA,
            )
            return
        if status != "selected" or time.time() - float(state.get("selected_at", 0)) > 1.0:
            return
        point = state.get("point_xy_px")
        if isinstance(point, list) and len(point) == 2:
            cv2.circle(frame, (int(point[0]), int(point[1])), 7, (0, 0, 255), 2)

    def draw_detection_overlay(self, frame, detection: dict | None) -> bool:
        """绘制只显示一帧的 DINO 检测红框。"""
        if not isinstance(detection, dict):
            return False
        objects = detection.get("objects")
        if not isinstance(objects, list) or not objects:
            return False

        for obj in objects:
            bbox = obj.get("bbox_xyxy_px") if isinstance(obj, dict) else None
            if not isinstance(bbox, list) or len(bbox) < 4:
                continue
            x1, y1, x2, y2 = [int(round(float(value))) for value in bbox[:4]]
            cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 0, 255), 2)
            cv2.putText(
                frame,
                str(obj.get("index", "?")),
                (max(0, x1), max(18, y1 - 6)),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.55,
                (0, 0, 255),
                2,
                cv2.LINE_AA,
            )
        return True

    def draw_tracking_overlay(
        self,
        frame,
        tracking: dict | None,
        display_frame_seq: int,
        draw_tracking_mask: bool,
    ) -> None:
        """绘制持续显示的 SAM2 分割红色填充。"""
        if not isinstance(tracking, dict):
            self.realtime_tracker.clear()
            self.frame_buffer.clear()
            return
        if not draw_tracking_mask:
            return
        self.realtime_tracker.draw(
            frame,
            display_frame_seq,
            require_sequence_match=self.display_mode == "matched",
        )


def main(args=None) -> None:
    rclpy.init(args=args)
    node = CameraViewSim("camera_view_sim")

    while rclpy.ok() and not node.should_exit:
        rclpy.spin_once(node, timeout_sec=0.01)

    cv2.destroyAllWindows()
    node.destroy_node()
    rclpy.shutdown()


if __name__ == "__main__":
    main()
